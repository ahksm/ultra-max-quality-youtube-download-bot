# Copy this file to `.env` and fill in your values.
# Get a token from @BotFather on Telegram.
BOT_TOKEN=your-telegram-bot-token-here

# Max upload size in MB. Standard Telegram Bot API caps this at 50.
# Raise it only if you run a local Bot API server (up to ~2000).
MAX_UPLOAD_MB=50

# Optional: where to store temporary downloads.
# DOWNLOAD_DIR=/tmp/yt_bot

# Optional: base URL of a local Bot API server for large uploads, e.g.
# TELEGRAM_API_BASE=http://localhost:8081/bot
